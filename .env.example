# Server
PORT=3000
SESSION_SECRET=generate-at-least-32-random-characters

# Gemini - keep server-side only
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Government of India OGD / AGMARKNET mandi API
DATA_GOV_API_KEY=

# Aiven MySQL
AIVEN_MYSQL_HOST=copy-the-current-aiven-mysql-host-here
AIVEN_MYSQL_PORT=15590
AIVEN_MYSQL_DATABASE=defaultdb
AIVEN_MYSQL_USER=avnadmin
AIVEN_MYSQL_PASSWORD=your_aiven_password
AIVEN_MYSQL_SSL=true

# Email OTP (Gmail SMTP example; use an App Password, not your Gmail password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=yourgmail@gmail.com
SMTP_PASSWORD=your_16_character_gmail_app_password
SMTP_FROM=yourgmail@gmail.com

# Google Identity Services OAuth client ID for the frontend
VITE_GOOGLE_CLIENT_ID=your_google_oauth_web_client_id

AIVEN_MYSQL_SSL_REJECT_UNAUTHORIZED=false
DEBUG_API_LOGS=false
